{
  "extends": "@cineseat/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src"
  },
  // ts-node runs prisma/seed.ts, which lives outside src/ — relax rootDir for it.
  "ts-node": {
    "compilerOptions": {
      "rootDir": "."
    }
  },
  "include": ["src"]
}
