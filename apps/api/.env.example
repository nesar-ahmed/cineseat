NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/dev.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3000
HOLD_MINUTES=5
REFUND_CUTOFF_HOURS=2
TICKET_SECRET=change-me-to-another-long-random-string
UPLOAD_DIR=./uploads
TIME_ZONE=Asia/Dhaka
# Printed on every invoice ("|" separates address lines).
INVOICE_SELLER_NAME=CineSeat Entertainment Ltd.
INVOICE_SELLER_ADDRESS=Level 4, 12 Gulshan Avenue
INVOICE_SELLER_CITY=Dhaka 1212
INVOICE_SELLER_COUNTRY=Bangladesh
INVOICE_SELLER_EMAIL=billing@cineseat.dev
INVOICE_SELLER_WEBSITE=cineseat.dev
# Payments are simulated: `mock` is the only provider (test cards only, no real money).
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change-me-to-a-third-long-random-string
MOCK_WEBHOOK_DELAY_MS=1500
PAYMENT_WINDOW_MINUTES=5
